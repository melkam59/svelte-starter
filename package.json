{
	"name": "svelte-starter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run && playwright test",
		"test:unit": "vitest",
		"test:integration": "vitest run --project integration",
		"test:coverage": "vitest run --coverage --project server --project integration",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"setup": "cp -n .env.example .env; pnpm db:up && pnpm db:migrate && pnpm db:seed",
		"db:up": "docker compose -f deployments/compose.yaml up -d db",
		"db:down": "docker compose -f deployments/compose.yaml down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env scripts/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node --env-file=.env scripts/seed.ts",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/schema/auth.ts --yes"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/noto-sans-ethiopic": "5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "4.1.12",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"bits-ui": "^2.20.3",
		"cn": "^0.5.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"drizzle-kit": "^0.31.10",
		"layerchart": "^2.9.2",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.10.0",
		"oxlint": "^1.20.0",
		"pino-pretty": "^13.2.0",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.7.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"mode-watcher": "^1.1.0",
		"phosphor-svelte": "^3.1.1",
		"pino": "^10.4.0",
		"postgres": "^3.4.7",
		"prom-client": "^15.1.3",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=24"
	}
}
