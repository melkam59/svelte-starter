# Database (local: `pnpm db:up`)
DATABASE_URL="postgres://app:app@localhost:5432/app"

# App origin, e.g. http://localhost:5173
ORIGIN="http://localhost:5173"

# Better Auth: 32+ high-entropy characters (`openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# Shown in the title bar, sidebar and sign-in page
APP_NAME="Starter"

# Logging: trace | debug | info | warn | error | fatal | silent (default: debug in dev, info in prod)
LOG_LEVEL=""
SERVICE_NAME="app"

# Set by the deploy; stamped on every log line and metric
APP_VERSION="dev"

# Bearer token for GET /api/metrics; empty disables it (32+ characters)
METRICS_TOKEN=""
